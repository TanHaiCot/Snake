  dialogueID: 4
  dialogueLines:
  - character:
      name: Boss 1
    line: 'Well...well...well... look who''s this...like father, like son '
  - character:
      name: Boss 1
    line: 'Cannot believe that this day has come so early   '
  - character:
      name: Me
    line: 'You know my dad...?   '
  - character:
      name: Boss
    line: 'Not only know, but know well, what an idiot... '
  - character:
      name: Me
    line: 'Don''t you dare talk aboutl my dad like that!  '
  - character:
      name: Boss 1
    line: Shut your mouth and watch me crush you into dust
